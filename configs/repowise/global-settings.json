{
  "env": {
    "ENABLE_TOOL_SEARCH": "true"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Grep|Glob|Read|Edit|Write|mcp__.*[Rr]epowise.*__.*",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v repowise-augment >/dev/null 2>&1; then exec repowise-augment; fi",
            "timeout": 10,
            "statusMessage": "Checking codebase context..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v repowise-augment >/dev/null 2>&1; then exec repowise-augment; fi",
            "timeout": 10,
            "statusMessage": "Loading repowise context..."
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Read|Edit|Write|Grep|Glob|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v repowise-augment >/dev/null 2>&1; then exec repowise-augment; fi",
            "timeout": 10,
            "statusMessage": "Checking codebase context..."
          }
        ]
      }
    ]
  },
  "theme": "dark",
  "mcpServers": {
    "repowise": {
      "command": "/Users/andrei/Library/Application Support/pipx/venvs/repowise/bin/repowise",
      "args": [
        "mcp",
        "/Users/andrei/Dev/Projects/HALO-Airport/halo-simulator-api",
        "--transport",
        "stdio"
      ],
      "description": "repowise: codebase intelligence \u2014 docs, graph, git signals, dead code, decisions"
    }
  }
}
