{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "GRAPHIFY_OUT=/Users/andrei/Dev/Projects/Claude-Benchmark/benchmark-repos/{REPO_NAME}/graphify-out /Users/andrei/.local/bin/graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "GRAPHIFY_OUT=/Users/andrei/Dev/Projects/Claude-Benchmark/benchmark-repos/{REPO_NAME}/graphify-out /Users/andrei/.local/bin/graphify hook-guard read"
          }
        ]
      }
    ]
  }
}
